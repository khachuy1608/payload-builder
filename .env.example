# Chuỗi kết nối Postgres (docker-compose.yml đi kèm tạo sẵn DB này)
DATABASE_URI=postgres://builder:builder@127.0.0.1:5432/builder

# Chuỗi bí mật ký JWT – đổi thành chuỗi ngẫu nhiên dài khi chạy thật
PAYLOAD_SECRET=change-me-to-a-long-random-string

# URL công khai của site (dùng cho nút Xem trước)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
